# CASCADE reads an OpenAI-compatible endpoint. Any provider works.
#
#   export $(grep -v '^#' .env | xargs)

# Required for the commands that call a model.
OPENROUTER_API_KEY=

# Optional — these are the defaults.
# CASCADE_MODEL=openai/gpt-5-image-mini
# CASCADE_BASE_URL=https://openrouter.ai/api/v1

# Where MVTec-LOCO images live, once downloaded. Default: ./data
# CASCADE_DATA=/path/to/mvtec_loco

# Where the mask pack lives. Default: ./masks
# CASCADE_MASKS=/path/to/masks
